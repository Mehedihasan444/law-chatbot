# Bangladesh Constitution Chatbot - Environment Variables

# Google Gemini API Configuration
GEMINI_API_KEY=AIzaSyA2gsn5AFWhajkR7YIw_NMCvyg8AczdwwA

# Model Configuration
LLM_MODEL=gemini-2.0-flash-exp
LLM_TYPE=gemini
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_STORE_TYPE=faiss

# Text Processing Settings
CHUNK_SIZE=512
CHUNK_OVERLAP=50
MAX_TOKENS=2048
TEMPERATURE=0.1
TOP_K_RETRIEVAL=5

# Optional: OpenAI API Key (if you want to use OpenAI models as fallback)
# OPENAI_API_KEY=your_openai_key_here

# Data Sources
CONSTITUTION_EN_URL=https://constitutionnet.org/sites/default/files/2021-11/Constitution%20of%20Bangladesh%20%28English%29.pdf