# Version control
.git
.gitignore

# Python cache
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# Virtual environments
venv/
env/
ENV/

# Environment & secrets (passed via compose env instead)
.env
.env.local

# Caches & downloaded models
