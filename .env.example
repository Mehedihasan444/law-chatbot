# Environment variables for the Bangladesh Constitution Chatbot

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Model Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LLM_MODEL=gemini-1.5-flash
LLM_TYPE=gemini
VECTOR_STORE_TYPE=faiss  # Options: faiss, pinecone

# Optional: OpenAI API (if you want to use OpenAI instead)
# OPENAI_API_KEY=your_openai_key_here
# LLM_MODEL=gpt-3.5-turbo
# LLM_TYPE=openai

# Application Settings (optimized for Gemini)
CHUNK_SIZE=512
CHUNK_OVERLAP=50
MAX_TOKENS=2048
TEMPERATURE=0.1
TOP_K_RETRIEVAL=5

# Language Settings
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,bn

# Data Sources
# https://wipolex-res.wipo.int/edocs/lexdocs/laws/en/bd/bd025en.pdf
CONSTITUTION_EN_URL=data\raw\bangladesh_constitution_en.pdf
CONSTITUTION_BN_URL=data\raw\bangladesh_constitution_bn.pdf